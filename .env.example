# =================================================================
# IotEnergyTracker — Environment Variables Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' (which is git-ignored):
#    cp .env.example .env
# 2. Update passwords and sensitive tokens with your secure values.
# =================================================================

# -----------------------------------------------------------------
# 1. User & Device PostgreSQL Database (user-db)
# -----------------------------------------------------------------
USER_DB_NAME=user_db
USER_DB_USER=user
USER_DB_PASSWORD=password
USER_DB_PORT=5433

# -----------------------------------------------------------------
# 2. TimescaleDB Time-Series Database (timescale-db)
# -----------------------------------------------------------------
TIMESCALE_DB_NAME=timescale_db
TIMESCALE_DB_USER=user
TIMESCALE_DB_PASSWORD=password
TIMESCALE_DB_PORT=5434

# -----------------------------------------------------------------
# 3. Apache Kafka
# -----------------------------------------------------------------
KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=9094
KAFKA_ENERGY_TOPIC=energy-usage-events

# -----------------------------------------------------------------
# 4. Microservice Application Ports
# -----------------------------------------------------------------
USER_SERVICE_PORT=8081
DEVICE_SERVICE_PORT=8082
INGESTION_SERVICE_PORT=8083
USAGE_SERVICE_PORT=8084
